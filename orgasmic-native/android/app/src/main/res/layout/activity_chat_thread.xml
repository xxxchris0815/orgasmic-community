<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F5F3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/thread_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Zurück"
            android:src="@drawable/ic_nav_back" />

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <TextView
                android:id="@+id/thread_letter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:textColor="#121c30"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/thread_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/thread_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#121c30"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/thread_delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Löschen"
            android:src="@drawable/ic_nav_delete"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/thread_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/thread_reply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:textColor="#7A746A"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/thread_image"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bild"
            android:src="@drawable/ic_nav_image" />

        <ImageButton
            android:id="@+id/thread_mic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sprachnachricht"
            android:src="@drawable/ic_nav_mic" />

        <EditText
            android:id="@+id/thread_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Nachricht"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_muted"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/thread_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Senden"
            android:src="@drawable/ic_nav_send" />
    </LinearLayout>
</LinearLayout>
